model User {
  id String @id @default(uuid())

  // Authentication
  email    String  @unique
  password String?
  username String? @unique

  // Profile
  firstName String?
  lastName  String?
  avatar    String?
  bio       String?

  // Authorization
  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  // Security
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  refreshToken  String?

  // Soft delete
  deletedAt DateTime?

  // AI personalization
  interests   String[]
  preferences Json?

  // Timestamps
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  newsInteractions NewsInteraction[]

  @@index([email])
  @@index([username])
  @@index([role])
  @@index([status])
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}
