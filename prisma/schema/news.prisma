enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NewsProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NewsInteractionType {
  VIEW
  CLICK
  LIKE
  SAVE
  SHARE
  HIDE
  NOT_INTERESTED
}

model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  feeds NewsFeed[]
  news  News[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsSource {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  baseUrl  String
  isActive Boolean @default(true)

  feeds NewsFeed[]
  news  News[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsFeed {
  id       String  @id @default(cuid())
  name     String
  url      String  @unique
  isActive Boolean @default(true)

  sourceId String
  source   NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  @@index([sourceId])
  @@index([isActive])
  @@index([isActive, sourceId])
}

model News {
  id        String  @id @default(cuid())
  title     String
  summary   String?
  content   String?
  sourceUrl String  @unique
  imageUrl  String?

  publishedAt DateTime?
  collectedAt DateTime  @default(now())

  status           NewsStatus           @default(PUBLISHED)
  processingStatus NewsProcessingStatus @default(PENDING)

  categoryId String
  sourceId   String

  category Category   @relation(fields: [categoryId], references: [id])
  source   NewsSource @relation(fields: [sourceId], references: [id])

  topics NewsTopic[]

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  newsInteractions NewsInteraction[]
  recommendations  UserRecommendation[]

  @@index([processingStatus])
  @@index([categoryId])
  @@index([sourceId])
  @@index([publishedAt])
  @@index([status])
  @@index([collectedAt])
  @@index([status, publishedAt, createdAt])
  @@index([status, categoryId, publishedAt, createdAt])
  @@index([status, sourceId, publishedAt, createdAt])
}

model NewsTopic {
  newsId  String
  topicId String

  news  News  @relation(fields: [newsId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([newsId, topicId])
  @@index([topicId])
}
